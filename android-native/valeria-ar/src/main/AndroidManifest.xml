<?xml version="1.0" encoding="utf-8"?>
<!--
  Valeria+ · Manifiesto del módulo de Realidad Aumentada.

  El permiso de CÁMARA se declara aquí, junto al código que lo usa, para que
  nunca pueda quedar declarado sin motivo: si algún día se retira el módulo,
  el permiso se va con él.

  `uses-feature` con `required="false"`: un teléfono sin cámara frontal debe
  poder instalar Valeria+ igual (los otros seis bloques no la necesitan); lo
  que hace el módulo es no ofrecerse en ese aparato.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      ARCore como capacidad OPCIONAL, nunca requerida. Los otros seis bloques no
      la necesitan y Valeria+ tiene que poder instalarse en un teléfono sin
      ARCore: `required="true"` la sacaría de la ficha de Play para todos ellos.

      Con "optional", ARCore no se instala solo: lo pide `ArCoreSession` en
      tiempo de ejecución con `ArCoreApk.requestInstall()`, y si el usuario dice
      que no, el bloque se retira y los otros seis siguen intactos.
    -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <application>
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <!--
          Pantalla completa, orientación fija en horizontal y sin barra de
          navegación: AR-3 es inviable en vertical (la pantalla abarca ~10° y
          las dianas quedarían indistinguibles), y una rotación a mitad de
          ensayo invalidaría la calibración.

          `screenOrientation="sensorLandscape"` y no `landscape` a secas para
          que el adulto pueda apoyar el teléfono en cualquiera de los dos
          sentidos: la compensación por IMU se encarga del resto.
        -->
        <activity
            android:name=".ValeriaArActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.ValeriaAr" />
    </application>

</manifest>
