<?xml version="1.0" encoding="utf-8"?>
<!--
  Tema del host de RA: pantalla completa sin barras del sistema y fondo negro.
  El niño ve su propio reflejo con la escena 3D encima; cualquier cromo de la
  app alrededor compite con el estímulo y desplaza la mirada, que es
  exactamente la variable que AR-3 mide.
-->
<resources>
    <style name="Theme.ValeriaAr" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
